{
  "name": "socialspark-disabled-preview-local-only",
  "main": "./cloudflare/offline-preview-worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
